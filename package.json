{
  "name": "elmbrook-card-game",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "snap": "tsx scripts/snap.ts",
    "snap:all": "tsx scripts/snap.ts --all",
    "e2e": "tsx scripts/e2e.ts",
    "art:sheet": "tsx scripts/art-sheet.ts",
    "art:check": "tsx scripts/art-check.ts",
    "render-texture": "tsx scripts/render-texture.ts",
    "art:import": "tsx scripts/import-backdrop.ts",
    "art:window": "tsx scripts/window-sheet.ts",
    "sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "phaser": "4.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
